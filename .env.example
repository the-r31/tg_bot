BOT_TOKEN=your_telegram_bot_token
MAX_FILE_SIZE_MB=49
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=20
DOWNLOAD_TIMEOUT=180
MAX_MEDIA_ITEMS=10
# Optional Netscape cookies file for your own account:
# COOKIES_FILE=cookies.txt
# Render supplies RENDER_EXTERNAL_URL and PORT automatically.
# Outside Render, set WEBHOOK_BASE_URL to enable webhook mode:
# WEBHOOK_BASE_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=optional_random_letters_digits_underscore_hyphen
